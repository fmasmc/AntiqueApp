<Window x:Class="AntiqueApp.Views.RegView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AntiqueApp.Views"
        xmlns:vm="clr-namespace:AntiqueApp.ViewModels"
        mc:Ignorable="d"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="RegView" 
        Height="1000" MinHeight="1000"
        Width="400" MinWidth="400">
    <Window.DataContext>
        <vm:RegViewModel/>
    </Window.DataContext>
    <Grid>
        <StackPanel Margin="30">
            <ui:TextBlock 
                Text="Регистрация"
                FontSize="34"
                HorizontalAlignment="Center"
                FontWeight="Bold"/>

            <ui:TextBlock
                Text="Имя"
                FontSize="20"
                Margin="0,60,0,0"/>
            <ui:TextBox
                Text="{Binding FirstName}"/>

            <ui:TextBlock
                Text="Фамилия"
                FontSize="20"
                Margin="0,20,0,0"/>
            <ui:TextBox
                Text="{Binding MiddleName}"/>
            
            <ui:TextBlock
                Text="Отчество"
                FontSize="20"
                Margin="0,20,0,0"/>
            <ui:TextBox
                Text="{Binding LastName}"/>
            
            <ui:TextBlock
                Text="Телефон"
                FontSize="20"
                Margin="0,20,0,0"/>
            <ui:TextBox
                Text="{Binding Phone}"/>
            
            <ui:TextBlock
                Text="Логин"
                FontSize="20"
                Margin="0,20,0,0"/>
            <ui:TextBox
                Text="{Binding Login}"/>

            <ui:TextBlock
                Text="Пароль"
                FontSize="20"
                Margin="0,20,0,0"/>
            <ui:TextBox
                Text="{Binding Password}"/>
            
            <ui:TextBlock
                Text="E-mail"
                FontSize="20"
                Margin="0,20,0,0"/>
            <ui:TextBox
                Text="{Binding Email}"/>
            
            <ui:TextBlock
                Text="Адрес доставки"
                FontSize="20"
                Margin="0,20,0,0"/>
            <ui:TextBox
                Text="{Binding DeliveryAddress}"/>


            <ui:Button 
                Content="Регистация"
                FontSize="20"
                Margin="0,60,0,0"
                Appearance="Primary"
                HorizontalAlignment="Stretch"
                Command="{Binding RegisterCommand}"/>

        </StackPanel>
    </Grid>
</Window>
