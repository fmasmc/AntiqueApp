<Page x:Class="AntiqueApp.Views.Pages.ExibitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:AntiqueApp.ViewModels"
      xmlns:local="clr-namespace:AntiqueApp.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ExibitPage">

    <Grid Background="White">
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Exhibits}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            CornerRadius="15"
                            BorderBrush="LightGray"
                            BorderThickness="2"
                            Background="#f7f7f7"
                            Margin="20">

                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:Image
                                        Source="{Binding Image}"
                                        Width="auto"
                                        Height="auto"
                                        Grid.Column="0"
                                        CornerRadius="5"
                                        MaxHeight="300"/>

                                    <StackPanel 
                                        Orientation="Vertical" 
                                        Grid.Column="1"
                                        Margin="20">

                                        <TextBlock 
                                            Text="Описание"
                                            FontSize="17"
                                            FontWeight="Bold"
                                            Margin="0,10,0,0"/>
                                        <TextBlock 
                                            Text="{Binding Description}"
                                            FontSize="16"/>

                                        <TextBlock 
                                            Text="Материал"
                                            FontSize="17"
                                            FontWeight="Bold"
                                            Margin="0,10,0,0"/>
                                        <TextBlock 
                                            Text="{Binding Material}"
                                            FontSize="16"/>

                                        <TextBlock 
                                            Text="Подкатегория"
                                            FontSize="17"
                                            FontWeight="Bold"
                                            Margin="0,10,0,0"/>
                                        <TextBlock 
                                            Text="{Binding Subcategory}"
                                            FontSize="16"/>

                                        <TextBlock 
                                            Text="Цена"
                                            FontSize="17"
                                            FontWeight="Bold"
                                            Margin="0,10,0,0"/>
                                        <TextBlock 
                                            Text="{Binding Price}"
                                            FontSize="16"/>

                                        <TextBlock 
                                            Text="Год создания"
                                            FontSize="17"
                                            FontWeight="Bold"
                                            Margin="0,10,0,0"/>
                                        <TextBlock 
                                            Text="{Binding Year}"
                                            FontSize="16"/>

                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock 
                                        Text="{Binding Author}"
                                        FontSize="20"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                        <ui:Button 
                                            Content="В корзину" 
                                            Command="{Binding AddToCartCommand}"
                                            Appearance="Primary"
                                            Visibility="{Binding AddToCartVisibility}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Page>
