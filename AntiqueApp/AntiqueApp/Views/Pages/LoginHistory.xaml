<Page x:Class="AntiqueApp.Views.Pages.LoginHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:AntiqueApp.ViewModels"
      xmlns:local="clr-namespace:AntiqueApp.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginHistory">

    <Page.DataContext>
        <vm:LoginHistoryViewModel/>
    </Page.DataContext>

    <Grid Background="White">
        <DataGrid ItemsSource="{Binding LoginHistory}"
          AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата входа"
                            Binding="{Binding LoginDate, StringFormat=dd.MM.yyyy HH:mm:ss}" />

                <DataGridTextColumn Header="Логин"
                            Binding="{Binding User.Login}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
