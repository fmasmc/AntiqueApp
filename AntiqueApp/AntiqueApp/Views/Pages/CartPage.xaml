<Page x:Class="AntiqueApp.Views.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:AntiqueApp.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:AntiqueApp.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">

    <Page.DataContext>
        <vm:CartViewModel/>
    </Page.DataContext>
    
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock 
                Text="Корзина"
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                Grid.Row="0"/>


            <ScrollViewer Margin="10" Grid.Row="1">
                <ItemsControl ItemsSource="{Binding CartItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                CornerRadius="2"
                                BorderBrush="LightGray"
                                BorderThickness="3"
                                Margin="5">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:Image
                                            Source="{Binding Image}"
                                            CornerRadius="5"
                                            Width="60"
                                            Height="60"/>

                                        <ui:TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Title}"
                                            VerticalAlignment="Center"
                                            Margin="10"/>

                                        <ui:Button 
                                            Grid.Column="2"
                                            Content="Удалить"
                                            Appearance="Dark"
                                            Command="{Binding DeleteFromCartCommand}"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="5">
                                        <ui:TextBlock Text="Цена: " FontWeight="SemiBold"/>
                                        <ui:TextBlock Text="{Binding Price}" FontWeight="SemiBold"/>
                                        <ui:TextBlock Text="р." FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                                
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="10">
                <TextBlock 
                    Text="Итого: "
                    FontSize="16"/>
                <TextBlock 
                    Text="{Binding TotalAmount}"
                    FontSize="16"/>
                <TextBlock 
                    Text="р."
                    FontSize="16"/>
            </StackPanel>
            

        </Grid>

                <Grid Grid.Column="1" Margin="50">
            <StackPanel Orientation="Vertical">
                <ui:TextBlock
                    Text="Адрес доставки"/>

                <ui:TextBox 
                    Text="{Binding Address}"/>

                <ui:TextBlock
                    Text="Тип оплаты" 
                    Margin="0,10,0,0"/>

                <ComboBox
                    SelectedItem="{Binding PaymentType}"
                    ItemsSource="{Binding PaymentTypes}"
                    DisplayMemberPath="Payment"/>

                <ui:TextBlock
                    Text="Комментарий к заказу"
                    Margin="0,10,0,0"/>

                <ui:TextBox 
                    Text="{Binding Commentary}"
                    MinHeight="70"
                    MaxHeight="120"
                    TextWrapping="Wrap"/>

                <ui:Button 
                    Appearance="Primary"
                    Content="Заказать"
                    Command="{Binding CreateOrderCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="30,40,30,0"
                    Height="40"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</Page>
