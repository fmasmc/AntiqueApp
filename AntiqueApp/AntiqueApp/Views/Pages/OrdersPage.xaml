<Page x:Class="AntiqueApp.Views.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:AntiqueApp.ViewModels"
      xmlns:local="clr-namespace:AntiqueApp.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrdersPage">

    <Page.DataContext>
        <vm:OrdersPageViewModel/>
    </Page.DataContext>

    <Grid Background="White">
        <ScrollViewer Margin="10" Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Orders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            CornerRadius="2"
                            BorderBrush="LightGray"
                            BorderThickness="3"
                            Margin="5">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <ui:TextBlock Text="{Binding Id}" Grid.Row="0" Margin="0,0,0,10"/>
                                
                                <ui:TextBlock Text="{Binding OrderItems}" Grid.Row="1" Margin="0,0,0,10"/>
                                
                                <StackPanel Orientation="Horizontal" Grid.Row="2">
                                    
                                    <ui:Button Content="Отменить заказ" 
                                        Appearance="Primary"
                                        Command="{Binding CancelOrderCommand}"/>

                                    <ComboBox
                                        SelectedItem="{Binding SelectedStatus}"
                                        ItemsSource="{Binding Statuses}"
                                        DisplayMemberPath="Name"
                                        Margin="10,0,0,0"/>
                                    
                                </StackPanel>


                            </Grid>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
