<Window x:Class="AntiqueApp.Views.AuthView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AntiqueApp.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AntiqueApp.Views" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="AuthView" 
        Height="600" MinHeight="600"
        Width="400" MinWidth="400">

    <Window.DataContext>
        <vm:AuthViewModel/>
    </Window.DataContext>

    <Grid>
        <StackPanel Margin="30">
            <ui:TextBlock 
                Text="Добро пожаловать"
                FontSize="34"
                HorizontalAlignment="Center"
                FontWeight="Bold"/>

            <ui:TextBlock
                Text="Логин"
                FontSize="20"
                Margin="0,60,0,0"/>
            <ui:TextBox
                Text="{Binding Login}"/>

            <ui:TextBlock
                Text="Пароль"
                FontSize="20"
                Margin="0,30,0,0"/>
            <ui:PasswordBox>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PasswordChanged">
                        <i:CallMethodAction TargetObject="{Binding}" MethodName="UpdatePassword"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ui:PasswordBox>

            <ui:Button 
                Content="Войти"
                FontSize="20"
                Appearance="Primary"
                Margin="0,40,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding AuthCommand}"/>
            
            <ui:Button 
                Content="Регистация"
                FontSize="20"
                Margin="0,40,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding RegistrationCommand}"/>
            
            <ui:Button 
                Content="Продолжить без авторизации"
                FontSize="20"
                Margin="0,40,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding ContinueWithoutAuthCommand}"/>

        </StackPanel>

    </Grid>
</Window>
